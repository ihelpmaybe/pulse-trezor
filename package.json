{
  "name": "pulse-trezor-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pulse Desk — Trezor Connect for PulseChain / HEX / PulseX / ProveX",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "setup": "npm install --ignore-scripts && node node_modules/esbuild/install.js",
    "test": "vitest run",
    "smoke": "npm run typecheck && npm run build && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@reown/walletkit": "^1.6.0",
    "@trezor/connect-web": "9.7.3",
    "@walletconnect/core": "^2.26.0",
    "@walletconnect/utils": "^2.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
