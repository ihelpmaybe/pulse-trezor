{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "pulsechain-hex-erc20",
    "contract": {
      "abi": "erc20",
      "deployments": [
        {
          "chainId": 369,
          "address": "0x2b591e99afe9f32eaa6214f7b7629768c40eeb39"
        }
      ]
    }
  },
  "metadata": {
    "owner": "HEX / PulseChain community overlay (Perch)",
    "contractName": "HEX",
    "info": { "url": "https://go.hex.com" },
    "token": {
      "name": "HEX",
      "ticker": "HEX",
      "decimals": 8
    }
  },
  "display": {
    "formats": {
      "transfer(address to, uint256 value)": {
        "intent": "Send HEX",
        "interpolatedIntent": "Send {value} HEX to {to}",
        "fields": [
          { "path": "#.to", "label": "To", "format": "addressOrName" },
          {
            "path": "#.value",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "tokenPath": "@.to", "decimals": 8, "ticker": "HEX" }
          }
        ]
      },
      "approve(address spender, uint256 value)": {
        "intent": "Approve HEX spender",
        "interpolatedIntent": "Allow {spender} to spend {value} HEX",
        "fields": [
          { "path": "#.spender", "label": "Spender", "format": "addressOrName" },
          {
            "path": "#.value",
            "label": "Allowance",
            "format": "tokenAmount",
            "params": { "decimals": 8, "ticker": "HEX" }
          }
        ]
      }
    }
  }
}
